# CORS - разрешенные источники для WebSocket и API (обязательно)
# Укажите через запятую все домены, с которых будете обращаться к API
ICQ_WEB_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:8000,http://127.0.0.1:8000

# Хост для запуска сервера (по умолчанию 0.0.0.0)
SERVER_HOST=0.0.0.0

# Порт для HTTP (по умолчанию 8000)
SERVER_PORT=8000

# Порт для HTTPS (по умолчанию 443)
SERVER_SSL_PORT=443

# Домен (используется только для подсказки в логах, по умолчанию localhost)
DOMAIN=your-domain.com

# Путь к директории с сертификатами (опционально, если не используете CERT_FILE и KEY_FILE)
# Если не указан, будет использован /etc/letsencrypt/live/${DOMAIN}
CERT_DIR=/path/to/certs

# Путь к файлу сертификата (обязателен для HTTPS)
# Если не указан, будет использован ${CERT_DIR}/fullchain.pem
CERT_FILE=/path/to/certificate.pem

# Путь к файлу приватного ключа (обязателен для HTTPS)
# Если не указан, будет использован ${CERT_DIR}/privkey.pem
KEY_FILE=/path/to/private.key